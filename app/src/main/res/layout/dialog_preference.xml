<?xml version="1.0" encoding="utf-8"?>
<!-- 设置项的选择对话框，对应参考实现的 dialog_setting.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/setting_dialog_width"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_white"
    android:gravity="center_vertical"
    android:minHeight="@dimen/setting_dialog_height"
    android:orientation="vertical"
    android:paddingStart="@dimen/setting_margin"
    android:paddingTop="@dimen/setting_margin"
    android:paddingEnd="@dimen/setting_margin">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/text_18sp" />

    <ListView
        android:id="@+id/lv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_medium"
        android:layout_marginBottom="@dimen/space_medium"
        android:background="@android:color/transparent"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_width"
        android:background="@color/gray_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/setting_btn_height"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="@dimen/setting_btn_width"
            android:layout_height="@dimen/setting_btn_height"
            android:background="@null"
            android:text="@string/dialog_cancel"
            android:textColor="@color/dialog_button_gray"
            android:textSize="@dimen/text_16sp" />

        <Button
            android:id="@+id/btn_confirm"
            android:layout_width="@dimen/setting_btn_width"
            android:layout_height="@dimen/setting_btn_height"
            android:background="@null"
            android:text="@string/dialog_confirm"
            android:textColor="@color/dialog_button_blue"
            android:textSize="@dimen/text_16sp" />
    </LinearLayout>
</LinearLayout>
