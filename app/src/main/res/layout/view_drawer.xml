<?xml version="1.0" encoding="utf-8"?>
<!--
  侧边抽屉。尺寸全部按原版实机实测：

    宽 230dp；顶部让出状态栏；标题栏 56dp（?actionBarSize）+ 1dp 分隔线 #E9E9E9；
    每项 56dp，图标 24dp 起于左边 16dp，文字起于 72dp；选中底色 #EFEFEF；
    列表上下各 8dp 留白。

    （原版在「推荐给朋友」下面还有一条分隔线和一组「超级 24 点」，那个功能不在
    复刻范围内，这里连分隔线一起删掉了。）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_container"
    android:layout_width="@dimen/navigation_width"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/white"
    android:orientation="vertical">

    <TextView
        android:id="@+id/drawer_title"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:gravity="center_vertical|start"
        android:paddingStart="@dimen/space_common"
        android:paddingEnd="@dimen/space_common"
        android:text="@string/app_name"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/nav_header_font_size" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/navigation_item_divider" />

    <LinearLayout
        android:id="@+id/drawer_group_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_middle"
        android:paddingBottom="@dimen/space_middle" />
</LinearLayout>
