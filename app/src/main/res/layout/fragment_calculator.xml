<?xml version="1.0" encoding="utf-8"?>
<!--
  计算页。原来是 activity_main 的全部内容，现在归到 Fragment 里：
  下面固定高度键盘，上面是「公式编辑器 + 运算按钮 + 空输入示例区」。

  顶区是个 FrameLayout 而不是 LinearLayout —— 原版就是叠的：
  编辑器 WebView 铺满（底部留 10dp），方法按钮条和示例条各按 layout_gravity="bottom"
  浮在上面。这样公式多长都不会把按钮挤下去，几何也和原版一致。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calculator_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_bg">

    <!-- 键盘：48dp 工具行 + 1px 分隔线 + (左书签栏 15% / 垂直翻页 85%) -->
    <LinearLayout
        android:id="@+id/math_keyboard"
        android:layout_width="match_parent"
        android:layout_height="@dimen/keyboard_height"
        android:layout_alignParentBottom="true"
        android:background="@color/keyboard_grid_bg"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/keyboard_top"
            android:layout_width="match_parent"
            android:layout_height="@dimen/keyboard_top_height"
            android:background="@color/keyboard_upper_bg"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/key_clear"
                style="@style/KeyboardToolKey"
                android:contentDescription="@string/keyboard_clear"
                android:src="@drawable/ic_keyboard_clear" />

            <TextView
                android:id="@+id/key_clipboard"
                style="@style/KeyboardToolKey"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/key_newline"
                style="@style/KeyboardToolKey"
                android:contentDescription="@string/keyboard_newline"
                android:src="@drawable/ic_keyboard_newline" />

            <ImageButton
                android:id="@+id/key_left"
                style="@style/KeyboardToolKey"
                android:contentDescription="@string/keyboard_left"
                android:src="@drawable/ic_keyboard_left" />

            <ImageButton
                android:id="@+id/key_right"
                style="@style/KeyboardToolKey"
                android:contentDescription="@string/keyboard_right"
                android:src="@drawable/ic_keyboard_right" />

            <ImageButton
                android:id="@+id/key_backspace"
                style="@style/KeyboardToolKey"
                android:contentDescription="@string/keyboard_backspace"
                android:src="@drawable/ic_keyboard_backspace" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="100">

            <LinearLayout
                android:id="@+id/keyboard_darts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="15"
                android:background="@color/keyboard_bookdart_bg"
                android:orientation="vertical">

                <FrameLayout style="@style/DartSlot">
                    <ImageView
                        android:id="@+id/dart1"
                        style="@style/KeyboardDart"
                        android:contentDescription="@string/dart_basic"
                        android:src="@drawable/ic_dart_pressed_1" />
                </FrameLayout>

                <FrameLayout style="@style/DartSlot">
                    <ImageView
                        android:id="@+id/dart2"
                        style="@style/KeyboardDart"
                        android:contentDescription="@string/dart_function"
                        android:src="@drawable/ic_keyboard_book2" />
                </FrameLayout>

                <FrameLayout style="@style/DartSlot">
                    <ImageView
                        android:id="@+id/dart3"
                        style="@style/KeyboardDart"
                        android:contentDescription="@string/dart_variable"
                        android:src="@drawable/ic_keyboard_book3" />
                </FrameLayout>

                <FrameLayout style="@style/DartSlot">
                    <ImageView
                        android:id="@+id/dart4"
                        style="@style/KeyboardDart"
                        android:contentDescription="@string/dart_formula"
                        android:src="@drawable/ic_keyboard_book4" />
                </FrameLayout>

                <!-- 第 5 格刻意留空，位置和参考实现一致 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:visibility="invisible" />
            </LinearLayout>

            <io.github.maximemet.supercalc.view.KeyboardStrip
                android:id="@+id/keyboard_scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="85"
                android:background="@color/keyboard_grid_bg"
                android:scrollbars="none" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/ll_top_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/math_keyboard"
        android:layout_marginStart="@dimen/space_large"
        android:layout_marginTop="@dimen/space_big"
        android:layout_marginEnd="@dimen/space_large">

        <!--
          公式区就是原版那个 MathQuill 编辑器页（assets/matheditor/editor.html）。
          公式、精确结果、数值结果三块都在页面里渲染，Kotlin 侧只负责算。

          WebView 不缩 bottom margin：示例行那 10dp（space_normalmethodbutton）
          现在靠 editor.css 里 #exampleTip 的 bottom 自己让出来。这样 WebView 的
          下边缘就等于示例行的下边，分数、积分这些比一行高的算式往下探的那截才
          不会被 WebView 裁掉（原版是位图，画多高都不会被裁）。
        -->
        <!--
          用 NoImeWebView：编辑器里光标一获得焦点，系统就会弹输入法盖住自绘键盘，
          原版不会。见 view/NoImeWebView.kt。
        -->
        <io.github.maximemet.supercalc.view.NoImeWebView
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:scrollbars="none" />

        <io.github.maximemet.supercalc.view.AutoLineLayout
            android:id="@+id/calculator_ops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="@dimen/methodbutton_margin"
            app:columns="4"
            app:columnSpace="@dimen/space_normal_6"
            app:rowSpace="@dimen/space_normal_6" />

        <!--
          空公式时底下那行示例。原版这里是一个横向 ViewPager 套一串位图，
          点一下就把示例公式填进编辑器；我们用文字 + 自己的例题列表，功能一样、不留原版素材。

          排布按原版实测来的：ViewPager 填满「全部举例」左边的整块空白，位图在里面
          水平居中（墨迹中心 562px vs 空白区中心 563px），高度被剩下的 25dp 卡住。
          所以正文也要居中，不能贴着「全部举例」右对齐。
        -->
        <LinearLayout
            android:id="@+id/view_empty_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/example_height"
            android:layout_gravity="bottom|start"
            android:orientation="horizontal">

            <!--
              示例正文不在这里：它是编辑器 WebView 里的 MathQuill 静态域渲染的
              （见 assets/matheditor/editor.html 的 #exampleTip）——文字直接排
              ∫₀¹、5/12 这种没有真正的数学排版，看着就不是原版那个样子。
              这里只留一块透明点击区，点一下把示例公式填进编辑器，
              宽度也正好决定算式居中时右边要空出多少。
            -->
            <View
                android:id="@+id/view_empty"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/space_medium"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tv_example"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/space_medium"
                android:gravity="end|center_vertical"
                android:text="@string/all_examples"
                android:textColor="@color/example_text"
                android:textSize="@dimen/example_text_size" />
        </LinearLayout>
    </FrameLayout>
</RelativeLayout>
