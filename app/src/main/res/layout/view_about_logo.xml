<?xml version="1.0" encoding="utf-8"?>
<!--
  「关于我们」里那个 90dp 的图标，M6 已换成本项目自己的标记：
  冷色圆角方块（bg_about_logo）+ 白色的根号和琥珀色等号（ic_about_logo_mark）。

  原来这里放的是参考实现那张网易品牌位图的重画版本，已经整体删除。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_about_logo" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/ic_about_logo_mark" />
</FrameLayout>
