<?xml version="1.0" encoding="utf-8"?>
<!--
  结构照抄参考实现的 fragment_calculator.xml / view_keyboard.xml：
  下固定高度键盘，上面是「编辑器 + 运算按钮 + 空输入示例区」。
  唯一的差别是编辑器暂时用 EditText 顶替 MathQuill 的 WebView（下一步换掉）。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_bg">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="@color/default_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_menu"
            style="@style/ToolbarButton"
            android:contentDescription="@string/action_menu"
            android:src="@drawable/ic_menu" />

        <TextView
            style="@style/ToolbarTitle"
            android:text="@string/title_calculate" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_history"
            style="@style/ToolbarButton"
            android:contentDescription="@string/action_history"
            android:src="@drawable/ic_history" />

        <ImageButton
            android:id="@+id/btn_undo"
            style="@style/ToolbarButton"
            android:contentDescription="@string/action_undo"
            android:src="@drawable/ic_undo" />

        <ImageButton
            android:id="@+id/btn_redo"
            style="@style/ToolbarButton"
            android:contentDescription="@string/action_redo"
            android:src="@drawable/ic_redo" />
    </LinearLayout>

    <View
        android:id="@+id/toolbar_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/toolbar"
        android:background="@color/action_bar_bottom" />

    <!-- 键盘：48dp 工具行 + 1px 分隔线 + (左书签栏 15% / 垂直翻页 85%) -->
    <LinearLayout
        android:id="@+id/math_keyboard"
        android:layout_width="match_parent"
        android:layout_height="@dimen/keyboard_height"
        android:layout_alignParentBottom="true"
        android:background="@color/keyboard_grid_bg"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/keyboard_top"
            android:layout_width="match_parent"
            android:layout_height="@dimen/keyboard_top_height"
            android:background="@color/keyboard_upper_bg"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/key_clear"
                style="@style/KeyboardToolKey"
                android:contentDescription="@string/keyboard_clear"
                android:src="@drawable/ic_clear" />

            <TextView
                android:id="@+id/key_clipboard"
                style="@style/KeyboardToolKey"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/key_newline"
                style="@style/KeyboardToolKey"
                android:contentDescription="@string/keyboard_newline"
                android:src="@drawable/ic_newline" />

            <ImageButton
                android:id="@+id/key_left"
                style="@style/KeyboardToolKey"
                android:contentDescription="@string/keyboard_left"
                android:src="@drawable/ic_left" />

            <ImageButton
                android:id="@+id/key_right"
                style="@style/KeyboardToolKey"
                android:contentDescription="@string/keyboard_right"
                android:src="@drawable/ic_right" />

            <ImageButton
                android:id="@+id/key_backspace"
                style="@style/KeyboardToolKey"
                android:contentDescription="@string/keyboard_backspace"
                android:src="@drawable/ic_backspace" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="100">

            <LinearLayout
                android:id="@+id/keyboard_darts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="15"
                android:background="@color/keyboard_bookdart_bg"
                android:orientation="vertical">

                <FrameLayout style="@style/DartSlot">
                    <TextView
                        android:id="@+id/dart1"
                        style="@style/KeyboardDart"
                        android:contentDescription="@string/dart_basic"
                        android:text="＋－&#10;×÷" />
                </FrameLayout>

                <FrameLayout style="@style/DartSlot">
                    <TextView
                        android:id="@+id/dart2"
                        style="@style/KeyboardDart"
                        android:contentDescription="@string/dart_function"
                        android:text="f" />
                </FrameLayout>

                <FrameLayout style="@style/DartSlot">
                    <TextView
                        android:id="@+id/dart3"
                        style="@style/KeyboardDart"
                        android:contentDescription="@string/dart_variable"
                        android:text="a-z" />
                </FrameLayout>

                <FrameLayout style="@style/DartSlot">
                    <TextView
                        android:id="@+id/dart4"
                        style="@style/KeyboardDart"
                        android:contentDescription="@string/dart_formula"
                        android:text="f(x)" />
                </FrameLayout>

                <!-- 第 5 格刻意留空，位置和参考实现一致 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:visibility="invisible"
                    android:layout_weight="1" />
            </LinearLayout>

            <io.github.maximemet.supercalc.view.KeyboardStrip
                android:id="@+id/keyboard_scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="85"
                android:background="@color/keyboard_grid_bg"
                android:scrollbars="none" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_top_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/math_keyboard"
        android:layout_below="@id/toolbar_divider"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_large"
        android:paddingTop="@dimen/space_big"
        android:paddingEnd="@dimen/space_large"
        android:paddingBottom="@dimen/space_normal">

        <!--
          公式区就是原版那个 MathQuill 编辑器页（assets/matheditor/editor.html）。
          公式、精确结果、数值结果三块都在页面里渲染，Kotlin 侧只负责算。
        -->
        <WebView
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:scrollbars="none" />

        <!--
          这块只用来显示「引擎启动中」这类状态和方法按钮算出来的纯文本。
          自动预览的结果由编辑器页自己渲染，不走这里。
        -->
        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/space_medium"
            android:textColor="@color/editor_result"
            android:textSize="18sp" />

        <io.github.maximemet.supercalc.view.AutoLineLayout
            android:id="@+id/calculator_ops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:columns="4"
            app:columnSpace="@dimen/space_normal_6"
            app:rowSpace="@dimen/space_normal_6" />

        <TextView
            android:id="@+id/tv_example"
            android:layout_width="match_parent"
            android:layout_height="@dimen/example_height"
            android:gravity="end|center_vertical"
            android:text="@string/all_examples"
            android:textColor="@color/example_text"
            android:textSize="12sp" />
    </LinearLayout>

</RelativeLayout>
