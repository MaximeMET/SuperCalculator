<?xml version="1.0" encoding="utf-8"?>
<!--
  外层骨架照参考实现的 activity_main.xml：抽屉 + 一条公共工具条 + 一个内容容器。

  原版这里还套了 ScrimInsetsFrameLayout（给抽屉留状态栏），我们这套是
  edge-to-edge，两条系统栏色带直接画在最上层，抽屉自己留出状态栏的高度。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_bg">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false">

        <LinearLayout
            android:id="@+id/page_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/default_bg"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/default_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_menu"
                    style="@style/ToolbarButton"
                    android:layout_width="@dimen/toolbar_nav_button"
                    android:contentDescription="@string/action_menu"
                    android:src="@drawable/ic_menu" />

                <ImageButton
                    android:id="@+id/btn_back"
                    style="@style/ToolbarButton"
                    android:layout_width="@dimen/toolbar_nav_button"
                    android:contentDescription="@string/action_back"
                    android:src="@drawable/ic_chevron_left"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/toolbar_title"
                    style="@style/ToolbarTitle"
                    android:text="@string/title_calculate" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_history"
                    style="@style/ToolbarButton"
                    android:contentDescription="@string/action_history"
                    android:src="@drawable/ic_history" />

                <ImageButton
                    android:id="@+id/btn_undo"
                    style="@style/ToolbarButton"
                    android:contentDescription="@string/action_undo"
                    android:src="@drawable/ic_undo" />

                <ImageButton
                    android:id="@+id/btn_redo"
                    style="@style/ToolbarButton"
                    android:contentDescription="@string/action_redo"
                    android:src="@drawable/ic_redo" />

                <ImageButton
                    android:id="@+id/btn_overflow"
                    style="@style/ToolbarOverflowButton"
                    android:contentDescription="@string/action_more"
                    android:src="@drawable/ic_overflow"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:id="@+id/toolbar_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/action_bar_bottom" />

            <FrameLayout
                android:id="@+id/content_frame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <include
            android:id="@+id/drawer_view"
            layout="@layout/view_drawer" />
    </androidx.drawerlayout.widget.DrawerLayout>

    <!--
      状态栏 / 导航栏那两条。原版是 targetSdk 22 的老应用，系统直接拿
      colorPrimaryDark 给状态栏上色、导航栏用系统默认黑；我们这边系统栏是透明的，
      所以自己画，并压在最上层（抽屉滑出来时状态栏那条也得保持深色）。
      高度由 MainActivity 按 insets 填。
    -->
    <View
        android:id="@+id/status_bar_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@color/status_bar" />

    <View
        android:id="@+id/nav_bar_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="@color/nav_bar" />
</FrameLayout>
