<?xml version="1.0" encoding="utf-8"?>
<!-- 参考实现的 dialog_loading.xml：半透明黑底圆角盒 + 白色转圈 + 一行白字 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/loading_width"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_loading_box"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/space_large">

    <ProgressBar
        android:id="@+id/progress_wheel"
        android:layout_width="@dimen/loading_wheel"
        android:layout_height="@dimen/loading_wheel"
        android:indeterminate="true"
        android:indeterminateTint="@color/white" />

    <TextView
        android:id="@+id/tv_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_common"
        android:textColor="@color/white"
        android:textSize="@dimen/text_16sp" />
</LinearLayout>
