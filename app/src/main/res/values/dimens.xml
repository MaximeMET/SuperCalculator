<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      数值取自参考实现的 dimens.xml。keyboard_height 是键盘总高，
      keyboard_top_height 是键盘上方那排工具键的高度。
    -->
    <dimen name="keyboard_height">400dp</dimen>
    <dimen name="keyboard_top_height">48dp</dimen>
    <dimen name="example_height">35dp</dimen>
    <dimen name="example_text_size">12sp</dimen>
    <!-- 原版示例正文是位图，按屏幕缩放；我们用文字，略小一档才放得下最长那条 -->
    <dimen name="example_content_text_size">11sp</dimen>

    <!--
      顶区（公式区）的三个间距，取自参考实现 fragment_calculator.xml：
      WebView 底下留 10dp 给方法按钮条，方法按钮条自己再离底 15dp。
    -->
    <dimen name="space_normalmethodbutton">10dp</dimen>
    <dimen name="methodbutton_margin">15dp</dimen>
    <dimen name="setting_enter_width">0dp</dimen>

    <dimen name="toolbar_height">48dp</dimen>
    <!-- 参考实现的导航按钮是 56dp 宽的方块，右侧菜单项才是 48dp -->
    <dimen name="toolbar_nav_button">56dp</dimen>

    <dimen name="capsule_button_height">30dp</dimen>
    <dimen name="capsule_button_radius">14dp</dimen>
    <!-- 原版的圆形书签位图是 64px(xhdpi)=32dp -->
    <dimen name="dart_size">32dp</dimen>

    <dimen name="space_micro">0.5dp</dimen>
    <dimen name="space_tiny">2dp</dimen>
    <dimen name="space_small">3dp</dimen>
    <dimen name="space_little">4dp</dimen>
    <dimen name="space_normal">5dp</dimen>
    <dimen name="space_normal_6">6dp</dimen>
    <dimen name="space_middle">8dp</dimen>
    <dimen name="space_medium">10dp</dimen>
    <dimen name="space_common">16dp</dimen>
    <dimen name="space_big">18dp</dimen>
    <dimen name="space_large">20dp</dimen>
    <dimen name="space_huge">30dp</dimen>
    <!-- 结果页底部操作条左右各 12dp（原版 space_normal = 12dp） -->
    <dimen name="space_normal_dp12">12dp</dimen>

    <!--
      结果页底部三个操作按钮：原版 ResultOperation 样式
      （minWidth 100dp、上下 padding 3dp、drawablePadding 16dp）。
    -->
    <dimen name="result_op_width">100dp</dimen>
    <dimen name="text_16sp">16sp</dimen>

    <dimen name="text_13sp">13sp</dimen>
    <dimen name="text_14sp">14sp</dimen>
    <dimen name="text_15sp">15sp</dimen>
    <dimen name="text_18sp">18sp</dimen>
    <dimen name="text_20sp">20sp</dimen>
    <dimen name="text_26sp">26sp</dimen>

    <!-- 抽屉：整宽 230dp、每行 56dp、图标 24dp（原版 NavigationView 的实测值） -->
    <dimen name="navigation_width">230dp</dimen>
    <dimen name="nav_header_font_size">20sp</dimen>
    <dimen name="nav_item_height">56dp</dimen>
    <dimen name="nav_item_icon">24dp</dimen>
    <!-- 图标右边 32dp，加起来文字正好从 72dp 开始 -->
    <dimen name="nav_item_text_margin">32dp</dimen>

    <!-- 设置页：行高 50dp、分组标题上下留白 24dp -->
    <dimen name="setting_height">50dp</dimen>
    <dimen name="setting_margin">24dp</dimen>
    <dimen name="setting_dialog_width">286dp</dimen>
    <dimen name="setting_dialog_height">234dp</dimen>
    <dimen name="setting_btn_width">80dp</dimen>
    <dimen name="setting_btn_height">50dp</dimen>
    <dimen name="setting_select_height">50dp</dimen>
    <dimen name="divider_width">1dp</dimen>

    <!-- 反馈页底部输入栏 -->
    <dimen name="min_height">48dp</dimen>
    <dimen name="loading_width">180dp</dimen>
    <dimen name="loading_wheel">40dp</dimen>
    <dimen name="about_logo_width">90dp</dimen>
    <dimen name="logo_margin_top">80dp</dimen>
    <!--
      键盘格子在原版里是位图（xhdpi 的 ic_keyboard_7 是 22x34px），
      放到 3x 屏上是 51px 高；16sp 的文字只有 36px，小了一大圈。
    -->
    <dimen name="key_text_size">23sp</dimen>
</resources>
